# Optional. Copy to .env to override defaults. Nothing here is required to run.

# Show PHP errors in the browser (development only)
APP_DEBUG=false

# Set to true once the app sits behind a reverse proxy / Cloudflare Tunnel that terminates HTTPS,
# so the app trusts X-Forwarded-Proto / X-Forwarded-For.
TRUST_PROXY=false

APP_TIMEZONE=America/New_York

# How many nightly backup snapshots to keep in ./backups
BACKUP_KEEP=30
