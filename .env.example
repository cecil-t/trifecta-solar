# Optional. Copy to .env to override defaults. Nothing here is required to run.

# Show PHP errors in the browser (development only)
APP_DEBUG=false

# Set to true when the app sits behind a reverse proxy / Cloudflare Tunnel that terminates HTTPS,
# so the app trusts X-Forwarded-Proto / X-Forwarded-For: Secure cookies and real visitor IPs.
TRUST_PROXY=false

APP_TIMEZONE=America/New_York

# Dashboard weather (Open-Meteo, no API key). Leave the coordinates out to hide the weather.
# WEATHER_PLACE=Springfield, PA
# WEATHER_LAT=40.0000
# WEATHER_LON=-76.0000

# Host address the container's port 8089 listens on (docker-compose.yml). Leave unset to listen on
# all addresses; set 127.0.0.1 when a reverse proxy on the same server is the only way in.
# APP_BIND=127.0.0.1

# Inverter monitoring (Lists > Monitor APIs). SolarEdge Monitoring API V2 Fleet Access key (developer.solaredge.com).
# Sent only in a request header. Keep it in .env, never in git.
# SOLAREDGE_API_KEY=
# Day of the month the SolarEdge credit cycle renews, and the credits per cycle (Free tier: 2000).
# The monitor:poll collector budgets against these.
# SOLAREDGE_CYCLE_DAY=1
# SOLAREDGE_CREDITS=2000

# Enphase installer data read from Enlighten Manager by signing in as an installer user (no API).
# Use an account without two-step verification. The session is kept next to the database.
# ENPHASE_ENLIGHTEN_EMAIL=
# ENPHASE_ENLIGHTEN_PASSWORD=

# APsystems OpenAPI (EMA installer account > Settings > OpenAPI Service).
# APSYSTEMS_APP_ID=
# APSYSTEMS_APP_SECRET=

# Growatt Shiner portal installer login (shiner-us.growatt.com). Signing in needs a captcha, typed once a
# month on Lists > Monitor APIs (Connect Growatt). The session is kept next to the database.
# GROWATT_USERNAME=
# GROWATT_PASSWORD=

# SMA Sunny Portal (ennexOS) installer SMA ID (ennexos.sunnyportal.com). Read by signing in, not an API;
# the session is kept next to the database.
# SMA_USERNAME=
# SMA_PASSWORD=

# SAM (System Advisor Model) for production estimates (Lists > Proposal APIs). The Docker image installs it in
# /opt/sam; set these only when running the app outside Docker with PySAM somewhere else.
# SAM_PYTHON=/opt/sam/bin/python
# SAM_LIB=/opt/sam/lib

# NSRDB weather for SAM (Lists > Proposal APIs > Weather): free API key from developer.nlr.gov and the email it
# was registered with. Weather files are downloaded once per NSRDB grid cell into data/solar/.
# NLR_API_KEY=
# NLR_EMAIL=

# Utility rates from OpenEI's Utility Rate Database (Lists > Proposal APIs > Utility rates): free key from
# openei.org/services/api/signup (a different key from NLR_API_KEY).
# OPENEI_API_KEY=

# WeasyPrint for PDFs (Lists > Proposal APIs > Test PDF). The Docker image installs it in /opt/pdf; set this only
# when running the app outside Docker.
# PDF_PYTHON=/opt/pdf/bin/python

# Google Maps Platform (Lists > Proposal APIs > Google): Geocoding, Solar API and Maps Static, called only from the
# server. Use a key restricted to the server's IP address and to those APIs.
# GOOGLE_MAPS_API_KEY=

# How many nightly backup snapshots to keep in ./backups
BACKUP_KEEP=30

# Where the database and snapshots live (defaults: data/trifecta.sqlite and backups/). Rarely needed;
# handy for pointing a local copy at a backup.
# DB_PATH=/var/www/app/data/trifecta.sqlite
# BACKUP_DIR=/var/www/app/backups
